# CiteMD configuration. Copy to .env (gitignored) and fill in secrets.
# All variables are optional; these are the ones relevant to generation.

# --- Generation backend (OpenAI-compatible) ---------------------------------
# Default routes through KVGate; that only works if the KVGate deployment has a
# provider key configured behind it. To run directly against Anthropic instead,
# uncomment the base URL below and set your key.

# Route through KVGate (the project's inference gateway):
# CITEMD_LLM_BASE_URL=https://kvgate.vercel.app/v1

# Or call Anthropic directly (OpenAI-compatible endpoint):
# CITEMD_LLM_BASE_URL=https://api.anthropic.com/v1/

CITEMD_LLM_API_KEY=
CITEMD_LLM_MODEL=claude-sonnet-4-6

# --- Optional: NCBI Entrez API key for faster PubMed ingestion --------------
# Raises the rate limit from ~3 to ~10 requests/sec. Used via the CLI/scripts.
# NCBI_API_KEY=
